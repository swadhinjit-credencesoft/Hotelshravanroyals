# Disable directory indexes (prevent viewing contents of /rooms/ folder)
Options -Indexes

# Disable MultiViews to avoid conflicts with file extension matching
Options -MultiViews

# Disable automatic trailing slash addition by Apache (crucial for /rooms folder conflict)
DirectorySlash Off

RewriteEngine On
RewriteBase /

# 1. Redirect index.html to clean URL (/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirect trailing slashes to non-trailing slashes (except root and actual files)
# Ensures consistency with canonical meta tags and avoids duplicate content.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ %1 [R=301,L]

# 3. Serve actual files directly if they exist
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 4. Rewrite clean URLs to their .html equivalent if the .html file exists
# E.g. /about -> about.html, /rooms -> rooms.html, /rooms/deluxe-ac-room -> rooms/deluxe-ac-room.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Serve Next.js 404 page for unmatched routes
ErrorDocument 404 /404.html
