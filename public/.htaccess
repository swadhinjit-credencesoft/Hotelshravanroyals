# Disable directory indexes (prevent viewing contents of /rooms/ folder)
Options -Indexes

# Disable MultiViews to avoid conflicts with file extension matching
Options -MultiViews

# Disable automatic trailing slash addition by Apache (crucial for /rooms folder conflict)
DirectorySlash Off

RewriteEngine On
RewriteBase /

# 1. Enforce HTTPS and Non-WWW (Canonical Domain)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://hotelsuryabellacasa.com/$1 [R=301,L]

# 2. Redirect obsolete room slugs to prevent 404 errors
RewriteRule ^rooms/lawn-facing-room/?$ /rooms/super-deluxe-room [R=301,L]
RewriteRule ^rooms/forest-facing-room/?$ /rooms/deluxe-ac-room [R=301,L]

# 3. Redirect index.html to clean URL (/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 4. Redirect trailing slashes to non-trailing slashes (except root and actual files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ %1 [R=301,L]

# 5. Serve actual files directly if they exist
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 6. Rewrite clean URLs to their .html equivalent if the .html file exists
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 7. Serve Next.js 404 page for unmatched routes
ErrorDocument 404 /404.html
